# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase → Connect → ORMs / Connection string
# Transaction pooler (port 6543): used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional. Session pooler (port 5432) for migrations; defaults to DATABASE_URL on port 5432.
DIRECT_URL=

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. Any long random string.
CRON_SECRET=

# Bearer token for /api/mcp (Day 5). Any long random string.
MCP_TOKEN=

# Where Kept is reached (production), for sign-up and Google sign-in links. Leave empty in dev.
SITE_URL=
